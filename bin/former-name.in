#!/bin/sh
# Generated by install.sh. Migration filet: the command Ponos was installed
# under before the rename, kept so that a script, a crontab or a desktop link
# that still calls it keeps working. Left out of the help and the docs on
# purpose, and removed in the version the CHANGELOG names.
echo "ticket-runner was renamed ponos — run ponos from now on" >&2
exec "@BIN@" "$@"
